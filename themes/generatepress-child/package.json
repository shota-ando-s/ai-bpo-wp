{
  "name": "hikitsugi-lp",
  "version": "1.0.0",
  "private": true,
  "description": "ヒキツギAI LP の Tailwind ビルド。生成物 assets/lp.css はコミットする（本番サーバーに node は無い）。",
  "scripts": {
    "build:lp": "tailwindcss -i ./assets/src/lp.css -o ./assets/lp.css --minify",
    "watch:lp": "tailwindcss -i ./assets/src/lp.css -o ./assets/lp.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
